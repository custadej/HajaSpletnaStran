# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.haja.si

# Google Analytics 4 measurement ID. Loaded only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=G-7QQ2C449QM

# SMTP settings used by the contact form (API route /api/contact).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@haja.si
SMTP_PASS=change-me
# Where contact form messages are delivered.
CONTACT_TO=info@haja.si
# Sender address shown on outgoing messages (must be allowed by your SMTP provider).
CONTACT_FROM=info@haja.si
